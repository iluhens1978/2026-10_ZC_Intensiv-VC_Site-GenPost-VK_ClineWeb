# ============================================================
#  ФАЙЛ ДЛЯ СЕКРЕТОВ — шаблон.
#  1. Скопируйте этот файл под именем  .env   (cp .env.example .env)
#  2. Вставьте свой ключ OpenRouter после знака "="
#  3. Файл .env добавлен в .gitignore — он НЕ попадает в репозиторий.
# ============================================================

# Ключ OpenRouter: https://openrouter.ai/keys
# Выглядит так: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=

# Модель. openrouter/free — роутер бесплатных моделей (Free Models Router)
OPENROUTER_MODEL=openrouter/free

# Адрес API — менять не нужно
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Необязательно: адрес и название проекта для статистики OpenRouter
APP_URL=http://127.0.0.1:5000
APP_TITLE=PostMaster AI
