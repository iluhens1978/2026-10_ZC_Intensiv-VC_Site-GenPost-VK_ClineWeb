# Служебные файлы Python — их не нужно хранить в репозитории
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Файлы с секретами: ключи и пароли НИКОГДА не попадают в репозиторий
.env
.env.*
!.env.example

# Данные сайта: избранные посты (создаются при работе)
data/

# Настройки редакторов и системы
.idea/
.vscode/
.DS_Store
